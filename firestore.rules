rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hot topics: written only by the Cloud Function (admin SDK bypasses
    // rules), readable by any signed-in (incl. anonymous) client.
    match /hotTopics/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Matchmaking queue: a player may only create/edit/delete their own
    // waiting-room entry. Anyone signed in can read the queue (needed to
    // find a waiting opponent client-side).
    match /matchQueue/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null; // matcher updates the *other* player's doc too
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Debates: only the two matched players can read/write their room,
    // and a player may only ever author a turn as themselves.
    match /debates/{debateId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.players;
      allow create: if request.auth != null; // created by the matcher's transaction
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.players;
      allow delete: if false;
    }
  }
}
